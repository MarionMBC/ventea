# Sirve el menu publico (build web de la app Ionic), el panel administrativo y la
# landing de ventea.tech (apps/landing). Todo es estatico: un solo nginx, que elige el
# sitio por el header Host (ver deploy/nginx.conf).

FROM node:22-bookworm-slim AS build

# La URL de la API y el slug del tenant se hornean en el bundle: Vite los resuelve
# en tiempo de build, no de ejecucion. Cambiarlos exige reconstruir la imagen.
ARG VITE_API_URL
ARG VITE_DEFAULT_TENANT_SLUG
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_DEFAULT_TENANT_SLUG=$VITE_DEFAULT_TENANT_SLUG

WORKDIR /repo

COPY package.json package-lock.json turbo.json ./
COPY packages/tsconfig/package.json      packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/shared/package.json        packages/shared/
COPY apps/api/package.json               apps/api/
COPY apps/mobile/package.json            apps/mobile/
COPY apps/admin/package.json             apps/admin/
COPY apps/landing/package.json           apps/landing/

RUN npm ci

COPY . .

RUN npm run build -w @ventea/shared \
 && npm run build -w @ventea/mobile \
 && npm run build -w @ventea/admin \
 && npm run build -w @ventea/landing

FROM nginx:1.27-alpine AS runtime

COPY --from=build /repo/apps/mobile/dist /usr/share/nginx/html
COPY --from=build /repo/apps/admin/dist  /usr/share/nginx/html/admin
COPY --from=build /repo/apps/landing/dist /usr/share/nginx/landing
COPY deploy/nginx.conf       /etc/nginx/conf.d/default.conf
COPY deploy/nginx-admin.conf /etc/nginx/ventea/admin-locations.conf
COPY deploy/nginx-security-headers.conf /etc/nginx/ventea/security-headers.conf

EXPOSE 80
