# Sirve el menu publico (build web de la app Ionic) y el panel administrativo.
# Ambos son estaticos: el mismo contenedor entrega los dos, en rutas distintas.

FROM node:22-bookworm-slim AS build

# La URL de la API y el slug del tenant se hornean en el bundle: Vite los resuelve
# en tiempo de build, no de ejecucion. Cambiarlos exige reconstruir la imagen.
ARG VITE_API_URL
ARG VITE_DEFAULT_TENANT_SLUG
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_DEFAULT_TENANT_SLUG=$VITE_DEFAULT_TENANT_SLUG

WORKDIR /repo

COPY package.json package-lock.json turbo.json ./
COPY packages/tsconfig/package.json      packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/shared/package.json        packages/shared/
COPY apps/api/package.json               apps/api/
COPY apps/mobile/package.json            apps/mobile/
COPY apps/admin/package.json             apps/admin/

RUN npm ci

COPY . .

RUN npm run build -w @ventea/shared \
 && npm run build -w @ventea/mobile \
 && npm run build -w @ventea/admin

FROM nginx:1.27-alpine AS runtime

COPY --from=build /repo/apps/mobile/dist /usr/share/nginx/html
COPY --from=build /repo/apps/admin/dist  /usr/share/nginx/html/admin
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
