# Sirve el menu publico (build web de la app Ionic), el panel administrativo, la
# landing de app.ventea.tech (apps/landing) y el sitio corporativo de ventea.tech
# (apps/site). Todo es estatico: un solo nginx, que elige el sitio por el header Host
# (ver deploy/nginx.conf).

FROM node:22-bookworm-slim AS build

# VITE_API_URL lo usa la landing (default `/api`). El menu publico (apps/mobile) lo
# ignora en su build web: la marca sale del host (`<slug>.ventea.tech`) y la API es
# siempre el mismo origen (`/api`), ver apps/mobile/src/brand/runtime.ts.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Instalación dedicada de un cliente (p. ej. Carolina, TASK-028): BRAND_FILE elige el archivo de
# marca de apps/mobile (`brands/brand.carolina.json`, con su idioma fijo) y ADMIN_IGNORE_BROWSER_LANG=1
# hace que el panel arranque en inglés aunque el navegador esté en español. Vacíos = imagen del SaaS.
ARG BRAND_FILE
ARG ADMIN_IGNORE_BROWSER_LANG
ENV VENTEA_BRAND_FILE=$BRAND_FILE
ENV VITE_ADMIN_IGNORE_BROWSER_LANG=$ADMIN_IGNORE_BROWSER_LANG

WORKDIR /repo

COPY package.json package-lock.json turbo.json ./
COPY packages/tsconfig/package.json      packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY packages/shared/package.json        packages/shared/
COPY apps/api/package.json               apps/api/
COPY apps/mobile/package.json            apps/mobile/
COPY apps/admin/package.json             apps/admin/
COPY apps/landing/package.json           apps/landing/
COPY apps/site/package.json              apps/site/

RUN npm ci

COPY . .

RUN npm run build -w @ventea/shared \
 && npm run build -w @ventea/mobile \
 && npm run build -w @ventea/admin \
 && npm run build -w @ventea/landing \
 && npm run build -w @ventea/site

FROM nginx:1.27-alpine AS runtime

COPY --from=build /repo/apps/mobile/dist /usr/share/nginx/html
COPY --from=build /repo/apps/admin/dist  /usr/share/nginx/html/admin
COPY --from=build /repo/apps/landing/dist /usr/share/nginx/landing
COPY --from=build /repo/apps/site/dist    /usr/share/nginx/site
COPY deploy/nginx.conf       /etc/nginx/conf.d/default.conf
COPY deploy/nginx-admin.conf /etc/nginx/ventea/admin-locations.conf
COPY deploy/nginx-security-headers.conf /etc/nginx/ventea/security-headers.conf

EXPOSE 80
