# ─────────────────────────────────────────────────────────────────────────────
# Instancia de UN cliente. Se copia como .env junto al docker-compose.prod.yml
# en el VPS del cliente. NUNCA se commitea: cada cliente tiene el suyo.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Identidad del cliente ───────────────────────────────────────────────────
DOMAIN=pedidos.carolinahotchicken.cl
PUBLIC_ORIGIN=https://pedidos.carolinahotchicken.cl
ACME_EMAIL=soporte@ejemplo.com

# ─── Modo de tenant ──────────────────────────────────────────────────────────
# single: la instancia atiende UNA marca. El slug se fija acá y no se resuelve
#         por subdominio ni por header. Es el modo normal en VPS del cliente.
# multi:  varias marcas en la misma instancia (hosting compartido nuestro).
#         Ahí el tenant sale del subdominio o del header X-Tenant-Slug.
TENANT_MODE=single
TENANT_SLUG=carolina-hot-chicken
# Solo se usa en TENANT_MODE=multi:
TENANT_BASE_DOMAIN=

# ─── Imágenes a desplegar ────────────────────────────────────────────────────
# SIEMPRE una etiqueta de versión concreta, nunca `latest`: con `latest` nadie
# sabe qué está corriendo y `docker compose up` puede cambiar la versión sola.
IMAGE_API=ghcr.io/<org>/ventea-api:0.1.0
IMAGE_WEB=ghcr.io/<org>/ventea-web:0.1.0

# ─── Base de datos ───────────────────────────────────────────────────────────
POSTGRES_USER=ventea
POSTGRES_PASSWORD=<generar: openssl rand -base64 32>
POSTGRES_DB=ventea
# El host es `postgres`, el nombre del servicio en la red interna de Docker.
DATABASE_URL=postgresql://ventea:<misma-password>@postgres:5432/ventea?schema=public

# ─── Secretos de la aplicación ───────────────────────────────────────────────
# Uno DISTINTO por cliente: reusar el secreto entre instancias haría que un token
# emitido para un cliente valga en la instancia de otro.
JWT_SECRET=<generar: openssl rand -base64 48>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
