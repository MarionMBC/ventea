{
  "name": "@ventea/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tone": {
      "types": "./dist/utils/tone.d.ts",
      "default": "./dist/utils/tone.js"
