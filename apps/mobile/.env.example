# Template only â€” copy to .env.development.local (git-ignored).
# Vite bakes VITE_* into dist/ (and so into the APK): never put a localhost URL
# in .env / .env.local, a production build would ship it.

# API origin without /api. Unset in `npm run dev` = same origin + Vite proxy.
# VITE_API_URL=https://api.ventea.tech

# Not read from .env files — pass them in the shell:
#   API_PROXY_TARGET=https://api.ventea.tech   dev proxy target for /api (default http://localhost:3000)
#   VENTEA_BRAND_FILE=brands/brand.carolina.json  brand to build/preview (default brand.config.json)
