{
  "name": "@ventea/mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-shared.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-shared.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "pretypecheck": "node scripts/ensure-shared.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-shared.mjs",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^9.0.1",
    "@ionic/react-router": "^9.0.1",
    "@ventea/shared": "*",
    "ionicons": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^6.30.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@ventea/eslint-config": "*",
    "@ventea/tsconfig": "*",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
