# Copy to keystore.properties (git-ignored) and fill in. One keystore PER BRAND,
# stored outside the repository and backed up: losing it means the app can
# never be updated on the Play Store again.
#
# Throwaway development keystore:
#   keytool -genkeypair -v -keystore brand-dev.keystore -alias brand-dev \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12 \
#     -dname "CN=Brand (development), O=Brand, C=CL"

# Path to the keystore, relative to the android/ directory or absolute.
storeFile=brand-dev.keystore
storePassword=
keyAlias=brand-dev
keyPassword=
