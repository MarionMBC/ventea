// ─────────────────────────────────────────────────────────────────────────────
// Ventea — modelo de datos multi-tenant.
//
// REGLA INNEGOCIABLE: toda tabla de negocio lleva `tenantId` y todo índice único
// de negocio lo incluye. Un unique sin tenantId (ej. email global) impediría que
// dos marcas distintas tengan el mismo cliente, y filtrar por él expondría datos
// entre tenants. Ver docs/multi-tenancy.md.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: la URL de conexion ya no vive en el schema. Migrate la lee de
// prisma.config.ts y el cliente la recibe por adapter (ver src/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

// ─── Plataforma (por encima de los tenants) ──────────────────────────────────

/// Nosotros, los que operamos y vendemos el SaaS. Único actor que cruza tenants.
model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  /// Va en el JWT (`ver`) y el guard lo compara: subirlo (--reset-password) invalida
  /// en el acto todos los tokens vivos del admin.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("platform_admins")
}

/// Una marca cliente del SaaS. Carolina Hot Chicken es el tenant #1, no un caso especial.
model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  currency  String   @db.Char(3)
  timezone  String   @default("America/Santiago")
  /// `false` = la marca no existe para nadie (404). La suspensión por falta de pago NO
  /// usa esto: es un estado de `Subscription` (402, el staff sigue entrando).
  isActive  Boolean  @default(true)
  /// Región donde vive la marca. La asigna la plataforma al registrarla (RegionService).
  region     String           @default("hn-1")
  createdVia TenantCreatedVia @default(script)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription    Subscription?
  billingEvents   BillingEvent[]
  paymentAttempts PaymentAttempt[]
  branding        TenantBranding?
  rewardProgram   RewardProgram?
  locations       Location[]
  categories      MenuCategory[]
  menuItems       MenuItem[]
  modifierGroups  ModifierGroup[]
  modifierOptions ModifierOption[]
  customers       Customer[]
  staff           StaffMember[]
  orders          Order[]
  rewardEntries   RewardLedgerEntry[]
  devices         Device[]

  @@map("tenants")
}

enum TenantCreatedVia {
  signup
  script
}

// ─── Suscripción (SaaS, ADR 0007) ────────────────────────────────────────────

/// Plan comercial. Catálogo GLOBAL: no lleva tenantId (exento del guard de tenant).
/// Lo siembra una migración SQL idempotente; cambiar un precio es otra migración.
model Plan {
  id                String   @id @default(uuid())
  /// `basic` | `pro` | `chain` (PLAN_CODE en @ventea/shared).
  code              String   @unique
  name              String
  priceMonthlyCents Int
  priceYearlyCents  Int
  currency          String   @default("USD") @db.Char(3)
  /// Sucursales activas permitidas. Null = ilimitadas.
  maxLocations      Int?
  /// `{ brandedApp, customDomain, reports, prioritySupport }` (booleanos).
  features          Json
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions        Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingPlan")
  paymentAttempts      PaymentAttempt[]

  @@map("plans")
}

/// Suscripción de una marca (1:1). El estado decide si su API pública atiende (402 si no).
model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  planId             String
  interval           BillingInterval
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)

  // Datos de cobro (TASK-005, ms-payments). Todos opcionales; hoy quedan en null.
  paymentProvider      String?
  /// Token de la tarjeta en la pasarela. Nunca el número de tarjeta.
  paymentToken         String?
  cardBrand            String?
  cardLast4            String? @db.Char(4)
  /// `networkTransactionId` del primer cobro: ancla los cobros recurrentes sin CVV.
  networkTransactionId String?
  /// Vencimiento de la tarjeta guardada: el cobro recurrente lo manda junto al token.
  cardExpMonth         Int?
  cardExpYear          Int?

  /// Cambio de plan agendado por el dueño: se aplica al abrir el próximo período.
  pendingPlanId   String?
  pendingInterval BillingInterval?
  /// Próximo reintento de cobro tras un rechazo (dunning: días 1, 3 y 7).
  retryAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  pendingPlan Plan?            @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  attempts    PaymentAttempt[]

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  canceled
}

enum BillingInterval {
  month
  year
}

/// Auditoría append-only de la suscripción: cambios de estado, de plan y (TASK-005) cobros.
model BillingEvent {
  id                    String           @id @default(uuid())
  tenantId              String
  type                  BillingEventType
  amountCents           Int?
  /// Resultado del cobro (`succeeded`, `failed`, `pending`…). Null en eventos sin cobro.
  status                String?
  providerTransactionId String?
  /// Clave idempotente hacia ms-payments (un orderId por intento de cobro).
  orderId               String?          @unique
  message               String?
  createdAt             DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("billing_events")
}

enum BillingEventType {
  trial_started
  trial_extended
  trial_expired
  plan_changed
  suspended
  reactivated
  canceled
  // TASK-005: cobro
  payment_succeeded
  payment_failed
  payment_unknown
  payment_method_updated
  plan_change_scheduled
  cancel_scheduled
  cancel_resumed
  past_due
  /// Algo para que una persona revise: posible doble pago, monto aprobado distinto, card-testing.
  billing_alert
}

/// Intento de cobro (TASK-005). Se escribe ANTES de llamar a la pasarela (write-ahead): si la
/// respuesta se pierde, la fila queda `pending`/`unknown` y el ciclo la reconcilia con
/// `status` en vez de cobrar de nuevo. A diferencia de `BillingEvent`, es mutable.
///
/// Lo que se cobra queda CONGELADO acá (plan, intervalo, período, monto): el resultado se
/// aplica con estos datos, nunca con el estado de la suscripción al momento de conciliar.
/// Una suscripción tiene como mucho UN intento abierto (pending/unknown) a la vez.
model PaymentAttempt {
  id                    String               @id @default(uuid())
  tenantId              String
  subscriptionId        String
  /// Clave idempotente hacia la pasarela. Renovaciones: determinística por período e intento.
  orderId               String               @unique
  kind                  PaymentAttemptKind
  /// Período que paga este intento, con el plan y el intervalo cobrados.
  periodStart           DateTime
  periodEnd             DateTime
  planId                String
  interval              BillingInterval
  /// Número de intento del período (1, 2…); también entra en el orderId.
  attempt               Int
  amountCents           Int
  currency              String               @db.Char(3)
  status                PaymentAttemptStatus @default(pending)
  providerTransactionId String?
  message               String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, subscriptionId, periodStart])
  @@index([status])
  @@map("payment_attempts")
}

enum PaymentAttemptKind {
  establish
  renewal
}

enum PaymentAttemptStatus {
  pending
  succeeded
  failed
  unknown
  /// No llegó al banco (400 de la pasarela: dato inválido). No cuenta para el dunning.
  failed_non_bank
  /// Aprobado distinto de lo pedido (monto, moneda, orderId, parcial): abierto, pero no se
  /// concilia solo; lo cierra una persona con `resolve-payment`.
  needs_review
}

/// Look and feel por marca: es lo que hace que el mismo binario se vea como otra app.
model TenantBranding {
  tenantId       String  @id
  logoUrl        String?
  primaryColor   String  @default("#E23B2E")
  secondaryColor String  @default("#1F1D1B")
  appDisplayName String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

// ─── Sucursales ──────────────────────────────────────────────────────────────

model Location {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  address   String
  latitude  Float
  longitude Float
  phone     String?
  /// Horario semanal como JSON: [{ day: 0-6, opens: "11:00", closes: "23:00" }]
  openingHours Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId, isActive])
  @@map("locations")
}

// ─── Catálogo ────────────────────────────────────────────────────────────────

model MenuCategory {
  id        String  @id @default(uuid())
  tenantId  String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id          String  @id @default(uuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  /// Precio en la unidad mínima de la moneda (centavos). Nunca decimal flotante.
  basePriceCents Int
  /// Precio anterior (tachado en la app). Null si no hay rebaja.
  compareAtPriceCents Int?
  /// Badges de la app: popular, new, hot, combo…
  tags           String[] @default([])
  isAvailable    Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifierGroups MenuItemModifierGroup[]
  orderLines     OrderLine[]

  @@index([tenantId, categoryId])
  @@index([tenantId, isAvailable])
  @@map("menu_items")
}

model ModifierGroup {
  id        String @id @default(uuid())
  tenantId  String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options ModifierOption[]
  items   MenuItemModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

model ModifierOption {
  id       String @id @default(uuid())
  tenantId String
  groupId  String
  name     String
  /// Puede ser negativo: quitar un ingrediente puede descontar.
  priceDeltaCents Int     @default(0)
  isAvailable     Boolean @default(true)
  sortOrder       Int     @default(0)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group            ModifierGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderLineOptions OrderLineOption[]

  @@index([tenantId, groupId])
  @@map("modifier_options")
}

/// Tabla puente: un grupo de modificadores se reutiliza en varios productos.
model MenuItemModifierGroup {
  menuItemId String
  groupId    String
  sortOrder  Int    @default(0)

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, groupId])
  @@map("menu_item_modifier_groups")
}

// ─── Personas ────────────────────────────────────────────────────────────────

/// Cliente final. El email es único POR TENANT: la misma persona puede tener
/// cuenta en dos marcas distintas y son cuentas separadas.
model Customer {
  id           String  @id @default(uuid())
  tenantId     String
  email        String
  phone        String?
  passwordHash String?
  firstName    String?
  lastName     String?
  /// Habilitó desbloqueo biométrico en algún dispositivo (el secreto vive en el device, no acá).
  biometricEnabled Boolean   @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]
  rewardEntries RewardLedgerEntry[]
  devices       Device[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

/// Empleado de la marca: usa el panel administrativo, no la app de cliente.
model StaffMember {
  id           String     @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         TenantRole @default(staff)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("staff_members")
}

enum TenantRole {
  owner
  manager
  staff
}

/// Dispositivo registrado: destino de push y ancla del login biométrico.
model Device {
  id         String         @id @default(uuid())
  tenantId   String
  customerId String
  platform   DevicePlatform
  pushToken  String?
  /// Identificador de la credencial biométrica. El secreto nunca sale del dispositivo.
  biometricKeyId String?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("devices")
}

enum DevicePlatform {
  ios
  android
  web
}

// ─── Pedidos ─────────────────────────────────────────────────────────────────

model Order {
  id         String  @id @default(uuid())
  tenantId   String
  locationId String
  customerId String?

  /// Código corto que se canta en el mostrador. Único dentro del tenant.
  code            String
  status          OrderStatus     @default(draft)
  paymentStatus   PaymentStatus   @default(pending)
  fulfillmentType FulfillmentType

  subtotalCents Int @default(0)
  discountCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  pointsEarned   Int @default(0)
  pointsRedeemed Int @default(0)

  customerNotes String?
  /// Header Idempotency-Key del POST que creó el pedido (único por cliente).
  idempotencyKey         String?
  /// sha256 del cuerpo validado: misma clave con otro cuerpo es un error del cliente.
  idempotencyRequestHash String?
  scheduledFor  DateTime?
  placedAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  rewardEntries RewardLedgerEntry[]

  @@unique([tenantId, code])
  @@unique([tenantId, customerId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, customerId, placedAt])
  @@index([tenantId, locationId, placedAt])
  @@map("orders")
}

enum OrderStatus {
  draft
  pending_payment
  confirmed
  preparing
  ready
  completed
  cancelled
}

enum PaymentStatus {
  pending
  authorized
  paid
  refunded
  failed
}

enum FulfillmentType {
  pickup
  dine_in
  delivery
}

/// Línea de pedido. Guarda SNAPSHOT de nombre y precio: si mañana sube el precio
/// o se borra el producto, el pedido histórico y su boleta no pueden cambiar.
model OrderLine {
  id             String  @id @default(uuid())
  tenantId       String
  orderId        String
  menuItemId     String?
  nameSnapshot   String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  notes          String?

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  options  OrderLineOption[]

  @@index([tenantId, orderId])
  @@map("order_lines")
}

model OrderLineOption {
  id              String  @id @default(uuid())
  tenantId        String
  orderLineId     String
  optionId        String?
  nameSnapshot    String
  priceDeltaCents Int

  orderLine OrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  option    ModifierOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([tenantId, orderLineId])
  @@map("order_line_options")
}

// ─── Puntos y recompensas ────────────────────────────────────────────────────

/// Reglas del programa de puntos: cada marca configura el suyo.
model RewardProgram {
  tenantId  String  @id
  isEnabled Boolean @default(false)
  /// Puntos otorgados por unidad monetaria gastada (ej. 1.0 = 1 punto por peso).
  pointsPerCurrencyUnit Float @default(1)
  /// Valor en centavos de 1 punto al canjear.
  redemptionValueCents Int      @default(1)
  minPointsToRedeem    Int      @default(0)
  signupBonusPoints    Int      @default(0)
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reward_programs")
}

/// Libro contable append-only de puntos. El saldo es SUM(points), nunca un
/// contador mutable: así toda variación queda con causa y es auditable.
model RewardLedgerEntry {
  id         String  @id @default(uuid())
  tenantId   String
  customerId String
  orderId    String?
  /// Positivo acredita, negativo debita.
  points    Int
  reason    RewardLedgerReason
  note      String?
  createdAt DateTime           @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId, createdAt])
  @@map("reward_ledger_entries")
}

enum RewardLedgerReason {
  order_earned
  redemption
  manual_adjustment
  expiration
  signup_bonus
}
