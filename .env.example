# ─── Copiar a .env y completar. .env NUNCA se commitea. ───

NODE_ENV=development

# ─── Base de datos (docker compose la levanta con estos valores) ───
POSTGRES_USER=ventea
POSTGRES_PASSWORD=ventea_local_dev
POSTGRES_DB=ventea
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ventea:ventea_local_dev@localhost:5432/ventea?schema=public

# ─── API ───
API_PORT=3000
API_URL=http://localhost:3000

# JWT: generar con `openssl rand -base64 48`. Uno distinto por entorno.
JWT_SECRET=cambiar-en-cada-entorno
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Modo de tenant ───
# multi:  producción (SaaS, ADR 0007): todas las marcas en la misma instancia; el
#         tenant sale del subdominio o del header X-Tenant-Slug. También en desarrollo.
# single: instalación dedicada a UNA marca (excepcional). El slug se fija acá.
TENANT_MODE=multi
TENANT_SLUG=carolina-hot-chicken

# Solo en TENANT_MODE=multi: dominio base para subdominios (<tenant>.ventea.tech)
TENANT_BASE_DOMAIN=ventea.tech
# Fallback en desarrollo cuando no hay subdominio ni header X-Tenant-Slug
DEFAULT_TENANT_SLUG=carolina-hot-chicken

# ─── Plataforma SaaS (opcionales) ───
# Regiones (JSON). Vacío = una sola: [{"code":"hn-1","countries":["*"],"currency":"HNL","timezone":"America/Tegucigalpa"}]
# REGIONS=
# Registros self-service por IP y hora (default 5) y logins de plataforma (default 20)
# SIGNUP_RATE_LIMIT_PER_HOUR=5
# Cupo GLOBAL de altas self-service, contado en la base (cada alta = un cert Let's Encrypt)
# SIGNUP_DAILY_LIMIT=10
# SIGNUP_WEEKLY_LIMIT=25
# PLATFORM_LOGIN_RATE_LIMIT_PER_HOUR=20
# Duración del token de administrador de plataforma (default 1h)
# PLATFORM_JWT_TTL=1h

# ─── Cobro de suscripciones (TASK-005, ver docs/deployment.md) ───
# manual (default): sin pasarela, el admin registra los pagos · ms-payments: tarjeta (CyberSource)
# BILLING_MODE=manual
# MS_PAYMENTS_URL=http://localhost:3001
# MS_PAYMENTS_KEY=
# MS_PAYMENTS_PROVIDER=cybersource
# MS_PAYMENTS_TIMEOUT_MS=30000
# BILLING_CYCLE_INTERVAL_MINUTES=15
# BILLING_SCHEDULER_ENABLED=true
# BILLING_RATE_LIMIT_PER_HOUR=5
# BILLING_IP_RATE_LIMIT_PER_DAY=10
# PCI: en producción con ms-payments el alta con número crudo se niega salvo esto (ver docs)
# ALLOW_RAW_CARD_API=

# ─── Apps cliente (Vite: solo variables VITE_* llegan al bundle — nunca secretos) ───
VITE_API_URL=http://localhost:3000
VITE_DEFAULT_TENANT_SLUG=carolina-hot-chicken

# ─── Integraciones (pendientes de definir proveedor) ───
# PAYMENTS_PROVIDER=
# PAYMENTS_API_KEY=
# PUSH_FCM_SERVER_KEY=
# MAPS_API_KEY=
